{
  "name": "Ewolution – Accueil des nouvelles demandes Google Groups",
  "flow": [
    {
      "id": 1,
      "module": "google-email:TriggerWatchEmails",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null,
        "folder": "INBOX",
        "searchType": "gmail",
        "gmailFilter": "from:(google.com OR googlegroups.com) subject:(demande OR request OR rejoindre OR join)",
        "markSeen": true,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Mail de demande d'adhésion" }
      }
    },
    {
      "id": 2,
      "module": "regexp:Parser",
      "version": 1,
      "parameters": {
        "pattern": "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})",
        "global": true,
        "sensitive": false,
        "multiline": false,
        "singleline": false,
        "continueWhenNoRes": false,
        "ignoreInfiniteLoopsWhenGlobal": false
      },
      "mapper": {
        "text": "{{1.text}}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Extraire l'adresse du demandeur" }
      }
    },
    {
      "id": 3,
      "module": "google-drive:getAFile",
      "version": 4,
      "parameters": {
        "__IMTCONN__": null
      },
      "filter": {
        "name": "Uniquement l'adresse du nouveau membre",
        "conditions": [
          [
            { "a": "{{2.`$1`}}", "b": "google.com", "o": "text:notcontain:ci" },
            { "a": "{{2.`$1`}}", "b": "googlegroups.com", "o": "text:notcontain:ci" },
            { "a": "{{2.`$1`}}", "b": "vincentlefeez@gmail.com", "o": "text:notequal:ci" }
          ]
        ]
      },
      "mapper": {
        "select": "map",
        "file": "1nQO9Yh6zZOf6W1ESw7laGlIbZJNuIXAE",
        "formatDocuments": "application/pdf",
        "formatSpreadsheets": "application/pdf",
        "formatPresentations": "application/pdf",
        "formatDrawings": "image/png"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "Présentation Ewolution (PDF)" }
      }
    },
    {
      "id": 4,
      "module": "google-email:ActionSendEmail",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "to": ["{{2.`$1`}}"],
        "subject": "Bienvenue dans la communauté Ewolution 🌿",
        "html": "<p>Bonjour,</p><p>Merci pour votre demande pour rejoindre le groupe Ewolution, je suis ravi de vous accueillir !</p><p>Le monde évolue… parce que nous évoluons. EWOLUTION est un écosystème collectif qui place l'humain au centre : apprendre, comprendre le monde, élever sa conscience, et surtout passer de la compréhension à l'action.</p><p>Vous trouverez en pièce jointe la présentation du projet, pour le découvrir à votre rythme.</p><p>Et pour en savoir plus : <a href=\"https://evolutionbienetre.fr/\">evolutionbienetre.fr</a></p><p>À très bientôt,<br>Vincent – Évolution Bien-Être</p>",
        "attachments": [
          {
            "fileName": "{{3.name}}",
            "data": "{{3.data}}"
          }
        ],
        "cc": [],
        "bcc": []
      },
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "Mail de bienvenue + pièce jointe" }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    },
    "designer": { "orphans": [] }
  }
}
